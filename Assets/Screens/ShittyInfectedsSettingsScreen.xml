      <ScrollPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3, 3">
        <StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">

          <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
            <LabelWidget Name="EnableCreatureAttacksLabel" Text="[ShittyInfectedsSettingsScreen:2]" HorizontalAlignment="Far" VerticalAlignment="Center" Margin="20, 0" Size="600, -1" WordWrap="true" />
            <BevelledButtonWidget Name="EnableCreatureAttacks" Style="{Styles/ButtonStyle_310x60}" VerticalAlignment="Center" Margin="20, 0" />
          </UniformSpacingPanelWidget>

          <UniformSpacingPanelWidget Direction="Horizontal" Margin="0, 3">
