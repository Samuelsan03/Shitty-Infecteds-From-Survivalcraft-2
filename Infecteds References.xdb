<ComponentTemplate Name="ZombieAI" Description="Inteligencia artificial especial para zombies, permite el uso de armas a distancia desde el inventario" Guid="86e4d4b9-95b6-4513-b87d-c2180cb16289" InheritanceParent="6cc7245f-56f2-4a77-a3db-5f628b6369b3">
